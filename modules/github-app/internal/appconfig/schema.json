{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub App definition for create-github-app",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "url", "permissions", "destination"],
  "properties": {
    "name": {
      "description": "Name of the GitHub App",
      "type": "string",
      "minLength": 1
    },
    "url": {
      "description": "Homepage URL of the GitHub App",
      "type": "string",
      "format": "uri"
    },
    "permissions": {
      "description": "default_permissions of the GitHub App manifest",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "enum": ["read", "write"] }
    },
    "destination": {
      "description": "Where to write the Client ID and the private key",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "environment", "credentialPrefix"],
          "properties": {
            "type": { "const": "environment" },
            "environment": {
              "description": "Environment of each repository to write the variable and the secret to",
              "type": "string",
              "minLength": 1
            },
            "credentialPrefix": {
              "description": "Prefix of <prefix>_APP_CLIENT_ID and <prefix>_APP_PRIVATE_KEY",
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "privateKeyFile" },
            "path": {
              "description": "Path of the file to write the private key to, relative to the working directory",
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
